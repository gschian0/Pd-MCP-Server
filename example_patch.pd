#X obj 50 545 list trim;
#X obj 50 560 t a a;
#X obj 121 571 list split 1;
#X obj 121 641 send;
#X msg 121 601 set \$1;
#X obj 20 616 list split 1;
#X obj 50 500 print SMSG-RAW;
#X obj 217 541 list prepend msg;
#X obj 217 571 list trim;
#X obj 217 601 s pd-workspace;
#X obj 217 511 print MSG-RAW;
#X obj 345 536 symbol;
#X msg 345 566 \; pd-workspace saveto \$1;
